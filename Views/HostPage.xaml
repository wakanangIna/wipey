<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wipey"
             x:Class="Wipey.HostPage"
             SafeAreaEdges="Container">
  <Grid RowDefinitions="*,Auto">
    <Grid>
      <local:HomeView x:Name="HomeV"/>
      <local:GalleryView x:Name="GalleryV" IsVisible="False"/>
      <local:ScheduleView x:Name="ScheduleV" IsVisible="False"/>
      <local:LogView x:Name="LogV" IsVisible="False"/>
    </Grid>
    <local:ProfileBar x:Name="Bar" Grid.Row="1"/>
  </Grid>
</ContentPage>
