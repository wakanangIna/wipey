<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wipey.ConfirmSheet"
             BackgroundColor="#99000000">
  <Grid>
    <BoxView Color="Transparent">
      <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnNo"/></BoxView.GestureRecognizers>
    </BoxView>

    <Border VerticalOptions="End" Padding="24,12,24,20" StrokeThickness="0" StrokeShape="RoundRectangle 26,26,0,0"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#272B3A}">
      <VerticalStackLayout Spacing="6">
        <Border WidthRequest="44" HeightRequest="5" HorizontalOptions="Center" StrokeThickness="0" StrokeShape="RoundRectangle 3"
                BackgroundColor="{AppThemeBinding Light=#D5D8E0, Dark=#4A5064}" Margin="0,0,0,10"/>
        <Label x:Name="TitleL" FontSize="20" FontAttributes="Bold"/>
        <Label x:Name="MsgL" Style="{StaticResource Mute}"/>
        <Border x:Name="PicHost" IsVisible="False" HeightRequest="150" Padding="0" Margin="0,10,0,0" StrokeThickness="0" StrokeShape="RoundRectangle 14">
          <Image x:Name="Pic" Aspect="AspectFill"/>
        </Border>
        <Button x:Name="YesBtn" Style="{StaticResource Primary}" Margin="0,18,0,0" Clicked="OnYes"/>
        <Button x:Name="NoBtn" Style="{StaticResource Plain}" FontAttributes="Bold" FontSize="16" Clicked="OnNo"/>
      </VerticalStackLayout>
    </Border>
  </Grid>
</ContentPage>
